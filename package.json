{
  "name": "ak-kaleidoscope",
  "version": "1.1.0",
  "description": "A lightweight JavaScript plugin for particle backgrounds.",
  "keywords": [
    "animation",
    "background",
    "canvas",
    "javascript",
    "kaleidoscope",
    "particles"
  ],
  "homepage": "https://github.com/kawakamiakari/kaleidoscope#readme",
  "bugs": {
    "url": "https://github.com/kawakamiakari/kaleidoscope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawakamiakari/kaleidoscope.git"
  },
  "license": "MIT",
  "author": "Kawakami Akari (https://github.com/kawakamiakari)",
  "type": "module",
  "main": "./dist/kaleidoscope.cjs",
  "module": "./dist/kaleidoscope.js",
  "types": "./dist/kaleidoscope.d.ts",
  "unpkg": "./dist/kaleidoscope.min.js",
  "jsdelivr": "./dist/kaleidoscope.min.js",
  "exports": {
    ".": {
      "import": "./dist/kaleidoscope.js",
      "require": "./dist/kaleidoscope.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown && cp dist/kaleidoscope.min.js docs/",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
